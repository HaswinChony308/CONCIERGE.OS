# ==========================================
# CONCIERGE ENVIRONMENT CONFIGURATION
# ==========================================

# Payment backend: "mock" (default, in-memory fake gateway) or "live_test" (real Razorpay test mode)
RAZORPAY_MODE=mock

# Only needed when RAZORPAY_MODE=live_test — must be TEST keys (rzp_test_...), never live keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx

# LLM Engine Provider: "mock" (default, zero keys needed), "anthropic", "openai", or "gemini"
CONCIERGE_PROVIDER=mock

# Optional API Keys (Only needed if CONCIERGE_PROVIDER is set to an external provider):
ANTHROPIC_API_KEY=
CONCIERGE_MODEL=claude-3-5-sonnet-20241022

OPENAI_API_KEY=
# CONCIERGE_MODEL=gpt-4o-mini

GEMINI_API_KEY=
# CONCIERGE_MODEL=gemini-2.0-flash

# Policy Guardrails
SPEND_CEILING_INR=2000

# Audit Trail Log Path
AUDIT_LOG_PATH=logs/audit.jsonl
